# Trinity Phase 2 - Environment Configuration
# Copy this file to .env and customize for your environment

# ============================================================================
# Database Configuration
# ============================================================================

# PostgreSQL Database
DB_PASSWORD=trinity_change_this_password
POSTGRES_PASSWORD=${DB_PASSWORD}
POSTGRES_DB=trinity_av_testing
POSTGRES_USER=trinity_user

# Database Host (use 'localhost' for local, 'database' for Docker)
DB_HOST=database
DB_PORT=5432
DB_NAME=trinity_av_testing
DB_USER=trinity_user

# ============================================================================
# Trinity Application Configuration
# ============================================================================

# Logging Level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
TRINITY_LOG_LEVEL=INFO

# Data Directory
TRINITY_DATA_DIR=./data

# GPU Configuration
TRINITY_USE_GPU=true
TRINITY_GPU_ID=0
TRINITY_NUM_WORKERS=4

# ============================================================================
# API Configuration
# ============================================================================

# API Server
TRINITY_API_HOST=0.0.0.0
TRINITY_API_PORT=8000

# API Authentication
TRINITY_API_KEY=your_secure_api_key_here

# ============================================================================
# Display Configuration (for GUI)
# ============================================================================

# X11 Display (Linux/macOS)
DISPLAY=:0

# Qt Configuration
QT_X11_NO_MITSHM=1

# ============================================================================
# Monitoring & Admin Tools
# ============================================================================

# Grafana
GRAFANA_PASSWORD=admin_change_this

# pgAdmin
PGADMIN_PASSWORD=admin_change_this
PGADMIN_DEFAULT_EMAIL=admin@trinity.local

# ============================================================================
# Redis Configuration
# ============================================================================

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# ============================================================================
# CARLA Simulator (Optional)
# ============================================================================

CARLA_HOST=carla-simulator
CARLA_PORT=2000

# ============================================================================
# Performance & Resource Limits
# ============================================================================

# Maximum Memory Usage (MB)
TRINITY_MAX_MEMORY_MB=8192

# Maximum CPU Usage (%)
TRINITY_MAX_CPU_PERCENT=80.0

# ============================================================================
# Security
# ============================================================================

# JWT Secret (for API authentication)
JWT_SECRET_KEY=your_very_secure_jwt_secret_change_this

# CORS Allowed Origins (comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# ============================================================================
# Development/Production Mode
# ============================================================================

# Environment (development, staging, production)
TRINITY_ENV=development

# Debug Mode
TRINITY_DEBUG=false
