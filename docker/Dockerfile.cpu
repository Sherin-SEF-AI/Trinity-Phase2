# Trinity Phase 2 - CPU-Only Dockerfile
# For systems without NVIDIA GPU support
FROM ubuntu:22.04

# Set environment variables
ENV PYTHONUNBUFFERED=1 \
    DEBIAN_FRONTEND=noninteractive \
    TZ=UTC

# Install system dependencies
RUN apt-get update && apt-get install -y \
    python3.10 \
    python3-pip \
    python3-dev \
    python3-opencv \
    git \
    wget \
    curl \
    build-essential \
    cmake \
    pkg-config \
    libssl-dev \
    # Qt6 dependencies
    qt6-base-dev \
    libqt6widgets6 \
    libqt6gui6 \
    libqt6core6 \
    libxcb-xinerama0 \
    libxkbcommon-x11-0 \
    libgl1-mesa-glx \
    libglib2.0-0 \
    # Video and camera dependencies
    ffmpeg \
    libavcodec-dev \
    libavformat-dev \
    libswscale-dev \
    libv4l-dev \
    v4l-utils \
    # OpenCV dependencies
    libjpeg-dev \
    libpng-dev \
    libtiff-dev \
    libgtk-3-dev \
    # 3D visualization dependencies
    libgl1-mesa-dev \
    libglu1-mesa-dev \
    freeglut3-dev \
    # PostgreSQL client
    postgresql-client \
    && rm -rf /var/lib/apt/lists/*

# Upgrade pip
RUN python3 -m pip install --upgrade pip setuptools wheel

# Set working directory
WORKDIR /app

# Copy requirements first for better caching
COPY requirements.txt .

# Install NumPy < 2.0 first (critical for lap package)
RUN pip install --no-cache-dir "numpy<2.0"

# Install PyTorch CPU version
RUN pip install --no-cache-dir torch torchvision torchaudio --index-url https://download.pytorch.org/whl/cpu

# Install Python dependencies
RUN pip install --no-cache-dir -r requirements.txt

# Copy application code
COPY . .

# Install the package in development mode
RUN pip install -e .

# Create necessary directories
RUN mkdir -p /app/data /app/recordings /app/exports /app/logs /app/models/weights

# Download YOLOv8 model (optional, can be done at runtime)
RUN python3 -c "from ultralytics import YOLO; YOLO('yolov8n.pt')" || true

# Expose ports
EXPOSE 8000 8001

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD python3 -c "import cv2; print('OK')" || exit 1

# Entry point
CMD ["python3", "-m", "trinity.main"]
